{
  "name": "mahesh-builds",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/gen-seo.mjs && node scripts/gen-og.mjs",
    "build": "vite build && node scripts/prerender.mjs",
    "build:ci": "node scripts/gen-seo.mjs && node scripts/gen-og.mjs && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build && node scripts/prerender.mjs",
    "seo": "node scripts/gen-seo.mjs && node scripts/gen-og.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "lenis": "^1.1.14",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.3"
  }
}
